{
  "name": "@dueboard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./rpc": {
      "bun": "./src/rpc.ts",
      "types": "./lib/rpc.d.ts",
      "import": "./lib/rpc.js",
      "default": "./lib/rpc.js"
    },
    "./limits": {
      "bun": "./src/limits.ts",
      "types": "./lib/limits.d.ts",
      "import": "./lib/limits.js",
      "default": "./lib/limits.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "deploy": "alchemy deploy",
    "dev": "alchemy dev",
    "destroy": "alchemy destroy",
    "logs": "alchemy logs",
    "tail": "alchemy logs --tail",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@alchemy.run/better-auth": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/drizzle": "catalog:",
    "@alchemy.run/neon": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "agents": "catalog:",
    "ai": "catalog:",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "zod": "catalog:"
  }
}
